      "oracle_mode": "EXTERNAL_SANDBOX_ORACLE",
      "acceptance": "static presence checks only; correctness is never self-graded",
      "oracle_runner": "experiments.evaluation.sandboxed_oracle::run_hidden_tests_in_sandbox",
      "scored_snapshot": "the exported workspace (artifacts.workspace_path), never the fixture",
      "public_suite_separation": "the public suite is a different artifact from the hidden oracle",
      "pre_claim_preflight": "run_live_preflight over the six production GoalRunOptions",
      "export_identity": {
        "archive": "artifacts.workspace_digest \u2014 the producer's sha256 of the transferred archive; recorded, not recomputable, never compared with a directory hash",
        "directory": "directory_digest \u2014 computed by the host after export and before the oracle, recomputed at audit time",
        "files": "workspace_files must equal the number of files the directory holds",
        "same_object": "the runner's workspace_path and the session's must name the same directory",
        "agreement": "the runner's and the session's archive digest must be the same value",
        "provenance": "the directory identity must come from the runner; a value that exists only in the session has no source and is refused",
        "fail_closed": "a missing directory identity, a changed directory, a count mismatch, a diverged path or a diverged archive digest stops the matrix"
      },
      "public_test_evidence": {
        "source": "session.public_tests.runs \u2014 one entry per call, no top-level status",
        "rule": "the last recorded run decides; a final record without a status is not the earlier PASS",
        "not_run": "a suite that never ran is NOT_RUN and is never a pass",
        "error": "an ERROR run leaves correctness unknown, it is not a failure and not a pass",
        "completeness": "calls must equal the number of recorded runs; a call that returned no record leaves the last observation unknown and is INCOMPLETE",
        "identity": "every run must name the frozen test id and command digest for its cell",
        "order": "call_index must be the contiguous position of the record",
        "outcome": "PASS must exit 0 and FAIL must exit non-zero; a contradiction is INVALID",
        "required": "B+ always configures the public suite; NOT_CONFIGURED is refused",
        "classification": "INCOMPLETE and INVALID are evidence-integrity stops; FAIL continues the matrix and is scored as a measured failure"
      },
      "v1_refusal": "live_preflight required a dynamic acceptance command; the B+ acceptance has none, and the oracle is a Host sandbox that runs after the run, so every cell was refused before the first model call",
      "v2_refusal": "the audit compared the producer's archive digest with a directory hash and read a top-level public_tests.status that the producer never writes, so a cell whose independent oracle passed was recorded as an integrity failure"
    },
