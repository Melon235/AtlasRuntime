@@ -72,7 +106,56 @@ def normalize_message_event(record: Mapping[str, Any]) -> NormalizedEvent:
     facts are handled by the channel's own converters, not here.
     """
 
-    raise NotImplementedError("message_events records are not normalized yet")
+    from plugins.message_events import (
+        SOURCE,
+        MessageEventError,
+        normalize_labels,
+        parse_timestamp,
+        severity_of,
+        stringify_payload,
+    )
+
+    try:
+        native_id = record["id"]
+        kind = record["type"]
+        occurred_at = parse_timestamp(record["sent_at"])
+        severity = severity_of(record.get("priority"))
+        tags = normalize_labels(record.get("labels"))
+        attributes = stringify_payload(record.get("payload"))
+    except KeyError as error:
+        raise _missing_field(SOURCE, error) from None
+    except MessageEventError as error:
+        # ``priority_out_of_range`` is this channel's own vocabulary; do not rewrite it.
+        raise NormalizationError(
+            f"{SOURCE}: {error}",
+            code=error.code,
+            detail={"source": SOURCE, "index": error.index},
+        ) from error
+
+    # The channel's identifier is numeric, so it is prefixed with the channel's short name to stay
+    # globally unique (``1041`` -> ``msg-1041``).
+    event_id = f"msg-{native_id}" if isinstance(native_id, int) else str(native_id)
+
+    return NormalizedEvent(
+        event_id=event_id,
+        source=SOURCE,
+        kind=kind,
+        occurred_at=occurred_at,
+        severity=severity,
+        attributes=attributes,
+        tags=tags,
+    )
+
+
+def _missing_field(source: str, error: KeyError) -> NormalizationError:
+    """A record that lacks a field the unified model cannot do without."""
+
+    field_name = error.args[0] if error.args else "?"
+    return NormalizationError(
+        f"{source}: native record is missing required field {field_name!r}",
+        code="missing_field",
+        detail={"source": source, "field": field_name},
+    )
 
 
