# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.idea/

# Local secrets
.env

# Local scratch: never a tracked artifact, never a source of evidence
_debug_run/

# Stage B E2F evidence: one real provisioning attempt, host-local and immutable.
# The raw directory is never tracked, never cleaned and never re-generated; the tracked
# artefact is experiments/stage_b_smoke/e2f-provisioning-index.json, which records every
# file's byte length and SHA-256 plus the review disposition. This rule excludes exactly
# that one directory and nothing else.
experiments/stage_b_smoke/e2f-provisioning/

# Stage B c3 calibration evidence: one real calibration attempt, host-local and immutable.
# The raw directory is never tracked, never cleaned and never re-generated; the tracked artefact is
# experiments/stage_b_calibration/c3-evidence-index.json, which records every file's byte length and
# SHA-256. This rule excludes exactly that one directory and nothing else, so the tracked c1/c2
# evidence directly beside it stays in git.
experiments/stage_b_calibration/calibration/

# Stage B 36-cell benchmark evidence: one directory per cell, host-local and immutable.
# The raw material is never tracked; what gets published from it is decided per cell, after the
# publication audit, so nothing under this root can be committed by accident.
experiments/stage_b_benchmark/cells/

# Experiment outputs
experiments/runs/
# Closure-2B-1 connectivity canary: local precheck/evidence output, machine-specific by nature.
experiments/results/closure2-canary/
# Raw per-run material stays local; only sanitized aggregates are published under evidence/.
experiments/evidence/**/runs/
experiments/results/evaluation/rounds/
experiments/results/evaluation/inspect-*/
experiments/results/stage-e1/
experiments/results/stage-e2/
experiments/results/stage-g1/
experiments/results/stage-g2a/
experiments/results/stage-g2b1/
experiments/results/stage-g3-1/
experiments/results/stage-g3-2/
experiments/results/stage-g3-3/
experiments/results/stage-g3-4a/
experiments/results/stage-r0/
experiments/results/stage-r0-5/
experiments/results/stage-r1-0/
experiments/results/stage-r1-1/
experiments/results/stage-r1-2/
experiments/results/stage-r1-2h/
experiments/results/stage-g2b-diagnosis/
experiments/results/stage-g3-audit/
experiments/results/evaluation/stage-e2/
experiments/results/evaluation/stage-e1/
